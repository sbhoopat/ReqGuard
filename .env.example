# ReqGuard AI Configuration Template
# Copy this file to .env and fill in your real values.
# DO NOT commit real secrets to this file!

# Server settings
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security
# Secret token required to invoke /api/v1/analyze manually (Authorization: Bearer <API_SECRET_KEY>)
API_SECRET_KEY=replace-with-a-secure-random-secret
# Secret configured in GitHub Webhook settings to verify HMAC SHA-256 signatures
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
# Optional comma-separated list of allowed repositories in format owner/repo (leave empty to allow all)
ALLOWED_REPOSITORIES=

# Groq LLM Configuration
# Valid Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Configurable model available to the account
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60.0

# GitHub Integration
# Personal Access Token with repo / pull requests & issues read/write
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE=https://api.github.com

# Jira Cloud Integration
# Base URL for Jira Cloud, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=https://your-company.atlassian.net
# Email address of the Jira Cloud service account
JIRA_USER_EMAIL=service-account@example.com
# Jira Cloud API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Jira Regex Pattern
# Regex used to extract Jira ticket key from PR title, branch name, or PR body
JIRA_ISSUE_KEY_REGEX=([A-Z][A-Z0-9]+-\d+)

# Analysis Limits & Guardrails
MAX_DIFF_CHARACTERS=60000
MAX_CHANGED_FILES=50
MAX_INVESTIGATION_ATTEMPTS=2
